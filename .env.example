# ============================================================
# ResumeVibe 环境变量模板
# 复制为 .env.local 使用（本地开发）。
# 部署到 Vercel 时：在 Vercel 项目 Settings → Environment Variables 中逐项填写，
# 见 memory-bank/vercel-deploy-guide.md。
# ============================================================

# ---------- AI 服务（文本模型）----------

# 服务端 API 密钥（不带 NEXT_PUBLIC_ 前缀，仅服务端可访问，不会暴露给浏览器）
# 生产部署务必只填这个，不要填 NEXT_PUBLIC_OPENAI_API_KEY
OPENAI_API_KEY=your_openai_api_key_here

# 服务端 AI 服务地址（OpenAI 兼容接口，如阿里云 MaaS compatible-mode）
# 本地使用 Ollama 时填 http://localhost:11434/v1
OPENAI_BASE_URL=your_openai_base_url_here

# 模型名（默认 qwen2.5）
NEXT_PUBLIC_MODEL_NAME=qwen3-coder-plus

# ---------- 浏览器端（测试页专用，⚠️ 部署时不要填，会泄露密钥）----------

# 仅本地开发/测试页（ai-test、error-handling-test、semantic-similarity-test）直连使用
# Vercel 上不要配置这两项，主流程走 /api/analyze 服务端路由，无需前端密钥
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here
NEXT_PUBLIC_OPENAI_BASE_URL=http://localhost:11434/v1

# ---------- Embedding（语义相似度）----------

# Embedding 模型名（语义相似度计算使用，默认 embedding-3）
NEXT_PUBLIC_EMBEDDING_MODEL_NAME=embedding-3

# Embedding API 地址（默认本地 Ollama http://localhost:11434/v1）
# Vercel 上无法访问 localhost：留空即可，系统会自动降级为本地词频向量计算
NEXT_PUBLIC_EMBEDDING_BASE_URL=http://localhost:11434/v1

# ---------- 应用基础配置 ----------

# 应用 URL（本地开发默认 http://localhost:3000）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- 限流与缓存（Upstash Redis）----------

# Upstash Redis REST URL（从 https://upstash.com 获取）
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here

# Upstash Redis REST Token（从 https://upstash.com 获取）
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# 每小时最大请求次数（默认 12）
MAX_REQUESTS_PER_HOUR=12

# 限流窗口（默认 3600 秒 = 1 小时）
RATE_LIMIT_WINDOW=3600
